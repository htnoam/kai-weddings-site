# KAI LEADS — environment variables
#
# The frontend currently reads NO environment variables (no import.meta.env.VITE_* usage
# besides Vite's built-in BASE_URL). Runtime connection settings live in
# app/public/config.json (public, non-secret Apps Script /exec URLs) and can be
# overridden per device in the app's Settings screen.
#
# The names below document the values involved, with placeholders only.
# They are NOT read by the build today — if you introduce them, wire them up explicitly.

# Apps Script "API" web-app deployment URL (access: Anyone). Public, not a secret.
KAI_LEADS_API_URL=https://script.google.com/macros/s/YOUR_API_DEPLOYMENT_ID/exec

# Apps Script "Sign-in" web-app deployment URL (access: Only myself). Public, not a secret.
KAI_LEADS_SIGNIN_URL=https://script.google.com/macros/s/YOUR_SIGNIN_DEPLOYMENT_ID/exec

# Vite base path used for production builds (the app is served at /leads/).
KAI_LEADS_BASE_PATH=/leads/

# Backend secrets are NOT env vars. They live in Apps Script → Project Settings → Script Properties:
#   SESSION_SECRET   (auto-generated by setup(); never copy it anywhere)
#   SESSION_VERSION  (bump to sign out every device)
